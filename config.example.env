# Copie este arquivo para ".env" para mudar alguma configuração.
# Sem o .env, os valores abaixo são usados como padrão.

# Porta do servidor (acesso: http://IP-DO-COMPUTADOR:PORTA)
PORTA=5050

# Pasta do banco de dados (relativa à pasta do projeto ou caminho completo)
PASTA_DADOS=dados

# Pasta dos backups. Pode apontar para o OneDrive ou uma pasta de rede,
# por exemplo: C:\Users\SeuUsuario\OneDrive\Backups\Calendario
PASTA_BACKUP=dados/backups

# Quantos backups manter (os mais antigos são apagados)
BACKUPS_MANTER=30

# Primeiro dia da semana no calendário: domingo ou segunda
SEMANA_COMECA=domingo

# Abrir o navegador automaticamente ao iniciar (1 = sim, 0 = não)
ABRIR_NAVEGADOR=1

# Feriados extras (municipais, por exemplo), separados por ponto e vírgula.
# Formato dd/mm Nome. Ex.: 15/08 N. Sra. da Assunção;13/04 Aniversário de Fortaleza
FERIADOS_EXTRAS=
